# Public application origin (set both to your final HTTPS origin in production)
NEXT_PUBLIC_SITE_URL=
APP_ORIGIN=

# Public Supabase project settings: publishable key only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public contact address
NEXT_PUBLIC_CONTACT_EMAIL=

# Exact comma-separated browser origins; leave empty to deny cross-origin access
PUBLIC_API_ALLOWED_ORIGINS=
# Enable only behind a proxy that overwrites client IP headers and cannot be bypassed
PUBLIC_API_TRUST_PROXY=false
# Production attestations: set true only after verifying provider-side controls
DEPLOY_TRUSTED_PROXY_CONFIRMED=false
DEPLOY_EDGE_RATE_LIMIT_CONFIRMED=false

# Server only. Required to approve requests and send Supabase invitations.
SUPABASE_SECRET_KEY=

# Free AI chat: server-only. Create a free key at https://openrouter.ai/keys
# The model is fixed in server code to a free endpoint; no paid fallback.
OPENROUTER_API_KEY=

# Enable only after approving NVIDIA free-endpoint recording/product-improvement terms.
OPENROUTER_ALLOW_NVIDIA_DATA_USE=false
