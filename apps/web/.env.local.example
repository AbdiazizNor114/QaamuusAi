# Public application origin (set both to your final HTTPS origin in production)
NEXT_PUBLIC_SITE_URL=
APP_ORIGIN=

# Supabase project settings: publishable key only, never service-role credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public contact address
NEXT_PUBLIC_CONTACT_EMAIL=

# Exact comma-separated browser origins; leave empty to deny cross-origin access
PUBLIC_API_ALLOWED_ORIGINS=
# Enable only behind a proxy that overwrites client IP headers and cannot be bypassed
PUBLIC_API_TRUST_PROXY=false
# Production attestations: set true only after verifying provider-side controls
DEPLOY_TRUSTED_PROXY_CONFIRMED=false
DEPLOY_EDGE_RATE_LIMIT_CONFIRMED=false
