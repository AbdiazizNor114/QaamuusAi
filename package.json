{
  "name": "qaamuusai",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @qaamuusai/web dev",
    "build": "pnpm --filter @qaamuusai/web build",
    "start": "pnpm --filter @qaamuusai/web start",
    "deploy:check": "node --env-file-if-exists=apps/web/.env.local tools/deploy-check.mjs",
    "deploy:smoke": "node tools/deploy-smoke.mjs",
    "test:deploy": "node --test tests/deployment.test.mjs",
    "typecheck": "pnpm --filter @qaamuusai/web typecheck",
    "lint": "pnpm --filter @qaamuusai/web lint",
    "test": "pnpm --filter @qaamuusai/web test",
    "test:e2e": "pnpm --filter @qaamuusai/web test:e2e",
    "test:db": "node --test tests/database.test.mjs tests/project-workspace.test.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "prettier": "3.9.10"
  }
}
